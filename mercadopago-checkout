    </div>


    <!-- RESUMO -->

    <div class="payment-summary">

      <h3>Resumo das configurações</h3>

      <div id="pagamentoResumo">
        Carregando...
      </div>

    </div>


    <button
      class="btn btn-primary"
      onclick="salvarConfiguracoesPagamento()"
    >
      💾 Salvar configurações
    </button>

