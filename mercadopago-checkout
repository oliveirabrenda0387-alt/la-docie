          Essas taxas ficam disponíveis somente para controle
          administrativo.
        </div>


        <div class="grid-2">

          <div class="field">

            <label>
              Taxa débito (%)
            </label>

            <input
              id="taxaDebito"
              type="number"
              min="0"
              step="0.01"
              placeholder="Ex.: 1.99"
            >

          </div>


          <div class="field">

            <label>
              Taxa crédito à vista (%)
            </label>

            <input
              id="taxaCreditoVista"
              type="number"
              min="0"
              step="0.01"
              placeholder="Ex.: 3.99"
            >

          </div>


          <div class="field">

            <label>
              Taxa crédito 2x (%)
            </label>

            <input
              id="taxaCredito2x"
              type="number"
              min="0"
              step="0.01"
              placeholder="Ex.: 5.99"
            >

          </div>


          <div class="field">

            <label>
              Taxa crédito 3x (%)
            </label>

            <input
              id="taxaCredito3x"
              type="number"
              min="0"
              step="0.01"
              placeholder="Ex.: 6.99"
            >

          </div>


          <div class="field">

            <label>
              Taxa crédito 4x (%)
            </label>

            <input
              id="taxaCredito4x"
              type="number"
              min="0"
              step="0.01"
              placeholder="Ex.: 7.99"
            >

          </div>

        </div>

