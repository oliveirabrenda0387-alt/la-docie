<!-- =========================================================
     JAVASCRIPT
     ========================================================= -->

<script>

/* =========================================================
   CONFIGURAÇÕES DE PAGAMENTO
   ========================================================= */

let configuracaoPagamento = null;


/* =========================================================
   CARREGAR CONFIGURAÇÕES
   ========================================================= */

async function carregarConfiguracoesPagamento(){

  try{

    const { data, error } =
      await supabaseClient
        .from("payment_settings")
        .select("*")
        .limit(1)
        .maybeSingle();

    if(error) throw error;

    configuracaoPagamento = data || null;

    if(!data){

      atualizarResumoPagamento();

      return;
    }


    document.getElementById("pagamentoPixChave")
      .value = data.pix_key || "";


    document.getElementById("pagamentoPixAtivo")
      .checked = data.pix_active !== false;


    document.getElementById("mercadoPagoAtivo")
      .checked = data.mercado_pago_active !== false;


    document.getElementById("mercadoPagoTaxaResponsavel")
      .value = data.fee_responsible || "loja";


    document.getElementById("credito2x")
      .checked = data.credit_2x !== false;


    document.getElementById("credito3x")
      .checked = data.credit_3x !== false;


    document.getElementById("credito4x")
      .checked = data.credit_4x !== false;


    document.getElementById("mercadoPagoDebito")
      .checked = data.debit_active !== false;


    document.getElementById("maquininhaAtiva")
      .checked = data.physical_machine_active !== false;


    document.getElementById("taxaDebito")
      .value = data.debit_fee ?? "";


    document.getElementById("taxaCreditoVista")
      .value = data.credit_cash_fee ?? "";


    document.getElementById("taxaCredito2x")
      .value = data.credit_2x_fee ?? "";


    document.getElementById("taxaCredito3x")
      .value = data.credit_3x_fee ?? "";


    document.getElementById("taxaCredito4x")
      .value = data.credit_4x_fee ?? "";


    atualizarResumoPagamento();

  }catch(error){

    console.error(
      "Erro ao carregar pagamentos:",
      error
    );

    mostrarMensagem(
      "Não foi possível carregar as configurações de pagamento.",
      "error"
    );

  }

}


/* =========================================================
   SALVAR CONFIGURAÇÕES
   ========================================================= */

async function salvarConfiguracoesPagamento(){

  const dados = {

    pix_key:
      document.getElementById("pagamentoPixChave")
        .value.trim() || null,

    pix_active:
      document.getElementById("pagamentoPixAtivo")
        .checked,

    mercado_pago_active:
      document.getElementById("mercadoPagoAtivo")
        .checked,

    fee_responsible:
      document.getElementById("mercadoPagoTaxaResponsavel")
        .value,

    credit_2x:
      document.getElementById("credito2x")
        .checked,

    credit_3x:
      document.getElementById("credito3x")
        .checked,

    credit_4x:
      document.getElementById("credito4x")
        .checked,

    debit_active:
      document.getElementById("mercadoPagoDebito")
        .checked,

    physical_machine_active:
      document.getElementById("maquininhaAtiva")
        .checked,

    physical_machine_pickup_only:
      true,

    debit_fee:
      Number(
        document.getElementById("taxaDebito")
          .value || 0
      ),

    credit_cash_fee:
      Number(
        document.getElementById("taxaCreditoVista")
          .value || 0
      ),

    credit_2x_fee:
      Number(
        document.getElementById("taxaCredito2x")
          .value || 0
      ),

    credit_3x_fee:
      Number(
        document.getElementById("taxaCredito3x")
          .value || 0
      ),

    credit_4x_fee:
      Number(
        document.getElementById("taxaCredito4x")
          .value || 0
      ),

    updated_at:
      new Date().toISOString()

  };


  try{

    let resultado;


    /* ATUALIZA */

    if(
      configuracaoPagamento &&
      configuracaoPagamento.id
    ){

      resultado =
        await supabaseClient
          .from("payment_settings")
          .update(dados)
          .eq(
            "id",
            configuracaoPagamento.id
          )
          .select()
          .single();

    }


    /* CRIA */

    else{

      resultado =
        await supabaseClient
          .from("payment_settings")
          .insert([dados])
          .select()
          .single();

    }


    if(resultado.error)
      throw resultado.error;


    configuracaoPagamento =
      resultado.data;


    atualizarResumoPagamento();


    mostrarMensagem(
      "Configurações de pagamento salvas com sucesso!"
    );


  }catch(error){

    console.error(error);

    mostrarMensagem(
      "Erro ao salvar pagamentos: " +
      error.message,
      "error"
    );

  }

}


/* =========================================================
   RESUMO
   ========================================================= */

function atualizarResumoPagamento(){

  const area =
    document.getElementById("pagamentoResumo");

  if(!area) return;


  const pix =
    document.getElementById("pagamentoPixAtivo")
      ?.checked;


  const mercadoPago =
    document.getElementById("mercadoPagoAtivo")
      ?.checked;


  const maquininha =
    document.getElementById("maquininhaAtiva")
      ?.checked;


  const parcelas = [];


  if(
    document.getElementById("credito2x")
      ?.checked
  ){

    parcelas.push("2x");

  }


  if(
    document.getElementById("credito3x")
      ?.checked
  ){

    parcelas.push("3x");

  }


  if(
    document.getElementById("credito4x")
      ?.checked
  ){

    parcelas.push("4x");

  }


  area.innerHTML = `

    <div class="payment-summary-row">
      <span>Pix</span>
      <strong>
        ${pix ? "Ativo" : "Desativado"}
      </strong>
    </div>


    <div class="payment-summary-row">
      <span>Mercado Pago</span>
      <strong>
        ${mercadoPago ? "Ativo" : "Desativado"}
      </strong>
    </div>


    <div class="payment-summary-row">
      <span>Crédito</span>
      <strong>
        ${
          parcelas.length
            ? parcelas.join(", ")
            : "Nenhum parcelamento"
        }
      </strong>
    </div>


    <div class="payment-summary-row">
      <span>Maquininha física</span>
      <strong>
        ${
          maquininha
            ? "Ativa — somente retirada"
            : "Desativada"
        }
      </strong>
    </div>

  `;

}


/* =========================================================
   ATUALIZA RESUMO AO ALTERAR CAMPOS
   ========================================================= */

document.addEventListener(
  "change",
  function(event){

    if(
      event.target.closest("#pagamentos")
    ){

      atualizarResumoPagamento();

    }

  }
);


/* =========================================================
   NOVO TÍTULO DO MENU
   ========================================================= */

const titulosOriginais =
  window.titulos || {};

</script>


